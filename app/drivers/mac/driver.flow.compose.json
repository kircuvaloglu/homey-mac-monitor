        "en": "CPU usage !{{is|is not}} above [[percent]] %"
      },
      "args": [
        {
          "name": "percent",
          "type": "number",
          "min": 1,
          "max": 100,
          "step": 1,
          "title": {
            "en": "Usage"
          },
          "placeholder": {
            "en": "80"
          }
        }
      ]
    },
    {
      "id": "memory_greater",
      "title": {
        "en": "Memory usage !{{is|is not}} above..."
      },
      "titleFormatted": {
