      "args": [
        {
          "name": "rpm",
          "type": "number",
          "min": 100,
          "max": 10000,
          "step": 100,
          "title": {
            "en": "Speed"
          },
          "placeholder": {
            "en": "3000"
          }
        }
      ],
      "tokens": [
