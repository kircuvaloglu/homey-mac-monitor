          },
          "placeholder": {
            "en": "90"
          }
        }
      ]
    },
    {
      "id": "disk_free_greater",
      "title": {
        "en": "Free disk space !{{is|is not}} above..."
      },
      "titleFormatted": {
        "en": "Free disk space !{{is|is not}} above [[gigabytes]] GB"
      },
      "args": [
        {
          "name": "gigabytes",
          "type": "number",
          "min": 1,
          "max": 4000,
          "step": 1,
          "title": {
            "en": "Free space"
          },
          "placeholder": {
            "en": "25"
          }
        }
      ]
    },
    {
      "id": "fan_greater",
      "title": {
        "en": "Fan speed !{{is|is not}} above..."
      },
      "titleFormatted": {
        "en": "Fan speed !{{is|is not}} above [[rpm]] RPM"
      },
      "args": [
        {
          "name": "rpm",
          "type": "number",
          "min": 100,
          "max": 10000,
          "step": 100,
          "title": {
            "en": "Speed"
          },
          "placeholder": {
