{
  "triggers": [
    {
      "id": "cpu_usage_above",
      "title": {
        "en": "CPU usage rises above..."
      },
      "titleFormatted": {
        "en": "CPU usage rises above [[percent]] %"
      },
      "hint": {
        "en": "Fires once each time the usage crosses the threshold upwards."
      },
      "args": [
        {
          "name": "percent",
          "type": "number",
          "min": 1,
          "max": 100,
          "step": 1,
          "title": {
            "en": "Usage"
          },
          "placeholder": {
            "en": "80"
          }
        }
      ],
      "tokens": [
        {
          "name": "percent",
          "type": "number",
          "title": {
            "en": "CPU usage (%)"
          },
          "example": 86.5
        }
      ]
    },
    {
      "id": "cpu_usage_below",
      "title": {
        "en": "CPU usage drops below..."
      },
      "titleFormatted": {
        "en": "CPU usage drops below [[percent]] %"
      },
      "hint": {
        "en": "Fires once each time the usage crosses the threshold downwards."
      },
      "args": [
        {
          "name": "percent",
          "type": "number",
          "min": 1,
          "max": 100,
          "step": 1,
          "title": {
