          }
        }
      ]
    },
    {
      "id": "power_greater",
      "title": {
        "en": "Power draw !{{is|is not}} above..."
      },
      "titleFormatted": {
        "en": "Power draw !{{is|is not}} above [[watts]] W"
      },
      "args": [
        {
          "name": "watts",
          "type": "number",
          "min": 1,
          "max": 1000,
          "step": 1,
          "title": {
            "en": "Power"
          },
          "placeholder": {
            "en": "30"
          }
        }
      ]
    },
    {
      "id": "has_updates",
      "title": {
        "en": "A macOS update !{{is|is not}} available"
      }
    }
  ],
  "actions": [
    {
      "id": "sleep",
      "title": {
        "en": "Put the Mac to sleep"
      },
      "hint": {
        "en": "The Mac becomes unreachable until it wakes up."
      }
    },
    {
      "id": "wake",
      "title": {
        "en": "Wake the Mac"
      },
      "hint": {
        "en": "Sends a Wake-on-LAN packet. Works for a sleeping Mac with \"Wake for network access\" turned on, not for a Mac that is shut down."
      }
    },
    {
      "id": "display_sleep",
      "title": {
        "en": "Turn off the display"
      }
    },
    {
      "id": "lock",
      "title": {
        "en": "Lock the screen"
      },
      "hint": {
        "en": "Starts the screen saver. The Mac locks when a password is required right after the screen saver starts. Needs a logged-in user."
      }
    },
    {
      "id": "notify",
      "title": {
        "en": "Show a notification on the Mac"
      },
      "titleFormatted": {
        "en": "Show notification [[title]]: [[message]]"
      },
      "hint": {
        "en": "Needs a logged-in user."
      },
      "args": [
        {
          "name": "title",
          "type": "text",
          "title": {
            "en": "Title"
          },
          "placeholder": {
            "en": "Homey"
          }
        },
        {
          "name": "message",
          "type": "text",
          "title": {
            "en": "Message"
          },
          "placeholder": {
            "en": "The washing machine is done"
          }
        }
      ]
    },
    {
      "id": "run_command",
      "title": {
        "en": "Run a command on the Mac"
      },
      "titleFormatted": {
        "en": "Run command [[command]]"
      },
      "hint": {
        "en": "Commands are defined in the agent's config.json on the Mac. The output is available as a token."
      },
      "args": [
        {
          "name": "command",
          "type": "autocomplete",
          "title": {
            "en": "Command"
          },
          "placeholder": {
            "en": "Select a command"
          }
        }
      ],
      "tokens": [
        {
          "name": "output",
          "type": "string",
          "title": {
            "en": "Output"
          },
          "example": "Backup finished"
        }
      ]
    },
    {
      "id": "refresh",
      "title": {
        "en": "Refresh the readings"
      }
    },
    {
      "id": "check_updates",
      "title": {
        "en": "Check for macOS updates"
      },
      "hint": {
        "en": "Takes up to a minute. Fires the update trigger when a new update is found."
      }
    },
    {
      "id": "restart",
      "title": {
        "en": "Restart the Mac"
      },
      "hint": {
        "en": "Must be allowed in the device settings and in the agent's config.json."
      }
    },
    {
      "id": "shutdown",
      "title": {
        "en": "Shut down the Mac"
      },
      "hint": {
        "en": "Must be allowed in the device settings and in the agent's config.json. A Mac that is shut down cannot be started from Homey."
      }
    }
  ]
}
