          "name": "rpm",
          "type": "number",
          "title": {
            "en": "Fan speed (RPM)"
          },
          "example": 3200
        }
      ]
    },
    {
      "id": "updates_found",
      "title": {
        "en": "A macOS update becomes available"
      },
      "tokens": [
        {
          "name": "count",
          "type": "number",
          "title": {
            "en": "Number of updates"
          },
          "example": 2
        },
        {
          "name": "names",
          "type": "string",
          "title": {
            "en": "Updates"
          },
          "example": "macOS 26.1, Safari 26.1"
        }
      ]
    },
    {
      "id": "rebooted",
      "title": {
        "en": "The Mac has restarted"
      },
      "hint": {
        "en": "Detected when the uptime resets."
      }
    },
    {
      "id": "went_offline",
      "title": {
        "en": "The Mac becomes unreachable"
      },
      "hint": {
        "en": "Also fires when the Mac goes to sleep or is shut down."
      }
    },
    {
      "id": "came_online",
      "title": {
        "en": "The Mac becomes reachable again"
      }
    }
  ],
  "conditions": [
    {
      "id": "is_online",
      "title": {
        "en": "The Mac !{{is|is not}} reachable"
      }
    },
    {
      "id": "cpu_temp_greater",
      "title": {
        "en": "CPU temperature !{{is|is not}} above..."
      },
      "titleFormatted": {
        "en": "CPU temperature !{{is|is not}} above [[celsius]] °C"
      },
      "args": [
        {
          "name": "celsius",
          "type": "number",
          "min": 30,
          "max": 110,
          "step": 1,
          "title": {
            "en": "Temperature"
          },
          "placeholder": {
            "en": "80"
          }
        }
      ]
    },
    {
      "id": "cpu_usage_greater",
      "title": {
        "en": "CPU usage !{{is|is not}} above..."
      },
